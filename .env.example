# Database configuration (Defaults to SQLite for local turnkey usage, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/medtrack?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="your-super-secret-jwt-key"
NEXTAUTH_URL="http://localhost:3000"

# Background Job Cron Secret
CRON_SECRET="your-cron-auth-secret"

# Optional External Notification Services
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15550001234"
